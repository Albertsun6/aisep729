#!/usr/bin/env bash
# e2e — E2E 研发平台 CLI（SPEC-26 / ADR-010）
#
# 子命令：
#   doctor   分层前置检查（基础层/远程层/目标栈层），缺项给安装指引
#   init     绿地脚手架：在当前目录生成平台目录树（幂等，不覆盖）
#   version  版本与实测基线
#
# 设计原则（ADR-010）：bash 只做薄编排；"零依赖"精确表述为"基础层零额外安装"。
set -u
E2E_VERSION="0.1.0-M1"
E2E_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<EOF
e2e ${E2E_VERSION} — 企业级端到端研发平台 CLI

用法: e2e <子命令>

  doctor              检查前置工具（分层：基础/远程/目标栈）
  init [目录]         在目标目录生成平台骨架（默认当前目录，幂等不覆盖）
  version             显示版本

文档: docs/process/stages/ · 宪法: docs/constitution.md
EOF
}

# ---------- doctor（SPEC-26）----------
cmd_doctor() {
  local miss=0 warn=0
  echo "== e2e doctor（前置分层检查，ADR-010）=="

  echo
  echo "【基础层】本地全流程必需"
  chk_req git      "brew install git（或 xcode-select --install）"      || miss=$((miss+1))
  chk_req bash     "macOS 自带；如缺请检查 PATH"                          || miss=$((miss+1))
  # Claude Code 用于跑 skill；探针本身不依赖它
  chk_opt claude   "npm install -g @anthropic-ai/claude-code" "跑 e2e-* skill 需要" || warn=$((warn+1))

  echo
  echo "【远程层】门禁③服务端校验与 CI 需要"
  chk_opt gh       "brew install gh && gh auth login" "门禁③（PR/checks）与 CI 操作需要" || warn=$((warn+1))

  echo
  echo "【目标栈层】按项目技术栈，缺失时相应能力降级"
  chk_opt jq       "brew install jq"          "结构化输出解析（AI 评审 workflow）" || warn=$((warn+1))
  chk_opt shellcheck "brew install shellcheck" "bash 项目的 ratchet linter 适配器" || warn=$((warn+1))

  echo
  if [ "$miss" -gt 0 ]; then
    echo "FAIL: 基础层缺 ${miss} 项——按上方指引安装后重试"
    return 1
  fi
  if [ "$warn" -gt 0 ]; then
    echo "PASS（有 ${warn} 项可选缺失）: 基础层齐备，相关能力将按 ADR-010 降级——不是错误"
    return 0
  fi
  echo "PASS: 全部前置齐备"
  return 0
}

chk_req() {  # chk_req <cmd> <安装指引>
  if command -v "$1" >/dev/null 2>&1; then
    printf '  ✅ %-12s %s\n' "$1" "$(command -v "$1")"; return 0
  fi
  printf '  ❌ %-12s 缺失 → %s\n' "$1" "$2"; return 1
}

chk_opt() {  # chk_opt <cmd> <安装指引> <用途>
  if command -v "$1" >/dev/null 2>&1; then
    printf '  ✅ %-12s %s\n' "$1" "$(command -v "$1")"; return 0
  fi
  printf '  ⚠️  %-12s 缺失（%s）→ %s\n' "$1" "$3" "$2"; return 1
}

# ---------- init（SPEC-9/10/11，M1 砍线：只出目录树）----------
cmd_init() {
  local target="${1:-.}"
  target="$(cd "$target" 2>/dev/null && pwd)" || { echo "FAIL(65): 目标目录不存在: ${1:-.}"; return 65; }
  [ "$target" = "$E2E_HOME" ] && { echo "FAIL(64): 不能在平台仓自身跑 init"; return 64; }

  echo "== e2e init → ${target} =="
  local conflicts=0 created=0

  # 目录树
  for d in .claude/skills .claude/agents .claude/hooks .claude/rules \
           docs/architecture/adr docs/process/stages docs/runbooks \
           specs scripts/lib tests/probe-negative .github/workflows; do
    mkdir -p "$target/$d"
  done

  # 复制平台能力（已实现的 skill + 公共库 + 探针）
  copy_tree ".claude/skills"  || true
  copy_tree ".claude/agents"  || true
  copy_tree "scripts/lib"     || true
  copy_one  "scripts/check-shell-traps.sh" || true
  copy_one  "scripts/check-structure.sh"   || true
  copy_one  "scripts/check-selfcontained.sh" || true
  copy_one  "scripts/ratchet.sh"           || true
  copy_one  "tests/probe-negative/run.sh"  || true
  copy_one  "tests/probe-negative/ratchet-negative.sh" || true
  copy_one  ".github/workflows/quality-gates.yml" || true
  copy_one  "docs/process/skills-manifest.md" || true
  copy_tree "docs/process/stages"          || true

  # 生成项目侧文件
  gen_file "AGENTS.md"        "$(tpl_agents)"
  gen_file "CLAUDE.md"        "$(tpl_claude_md)"
  gen_file "docs/constitution.md" "$(tpl_constitution)"
  gen_file "docs/glossary.md" "$(tpl_glossary)"
  gen_file ".claude/settings.json" "$(tpl_settings)"

  echo
  if [ "$conflicts" -gt 0 ]; then
    echo "完成（${created} 个新建，${conflicts} 个已存在未覆盖）"
    echo "⚠️  冲突项已保留原文件（SPEC-10 幂等安全）"
    return 2
  fi
  echo "PASS: ${created} 个文件已生成"
  echo "下一步: cd ${target} && e2e doctor，然后用 e2e-discovery skill 立项"
  return 0

}

copy_tree() { [ -d "$E2E_HOME/$1" ] || return 1; mkdir -p "$target/$1"; cp -R "$E2E_HOME/$1/." "$target/$1/" 2>/dev/null; created=$((created+1)); printf '  + %s/\n' "$1"; }
copy_one()  { [ -f "$E2E_HOME/$1" ] || return 1
  if [ -f "$target/$1" ]; then printf '  = %s（已存在，跳过）\n' "$1"; conflicts=$((conflicts+1)); return 0; fi
  mkdir -p "$(dirname "$target/$1")"; cp "$E2E_HOME/$1" "$target/$1"; created=$((created+1)); printf '  + %s\n' "$1"; }
gen_file()  {
  if [ -f "$target/$1" ]; then printf '  = %s（已存在，跳过）\n' "$1"; conflicts=$((conflicts+1)); return 0; fi
  mkdir -p "$(dirname "$target/$1")"; printf '%s\n' "$2" > "$target/$1"; created=$((created+1)); printf '  + %s\n' "$1"; }

# ---------- 模板 ----------
tpl_claude_md() { cat <<'EOF'
# 项目上下文（Claude Code 常驻规则）

> 本文件 ≤200 行（SPEC-11）。深知识放 skills 按需加载，工程原则见宪法。

@docs/constitution.md

## 本项目

- 生命周期：六段治理底图 × 产物状态机（见 docs/process/stages/）
- 制品位置：`specs/<feature>/`（prfaq→prd→spec/plan→tasks）
- 门禁：⓪立项 ①需求 ②架构 ③合并 ④发布 ⑤退役
- 能力：`.claude/skills/e2e-*`（拓扑见 docs/process/skills-manifest.md）

## 纪律

- 未过门禁不进下一段（skill 第 0 步自校验）
- 每条任务带可执行验证方式；能验证的绝不用"我觉得对了"
- 探针在 `scripts/` 与各 skill 的 `scripts/`，交付前必须跑
EOF
}

tpl_agents() { cat <<'EOF'
# AGENTS.md — 工具无关的 agent 入口

本仓库采用六段端到端生命周期 + 产物状态机，制品在 `specs/<feature>/`。

## 快速上手
- 前置检查：`e2e doctor`
- 结构自审：`bash scripts/check-structure.sh`（若存在）
- 阶段定义：`docs/process/stages/`
- 工程宪法：`docs/constitution.md`（不可妥协原则）

## 约定
- 产物是真相（`docs/` `specs/`），`.claude/` 只是 Claude 适配层
- 门禁记录在各制品尾部；试点模式下为流程留痕，非防伪审批证据
EOF
}

tpl_constitution() { cat <<'EOF'
# 工程宪法（Constitution）

> 项目级不可妥协原则。修宪 = 独立 ADR。每条：原则 + 为什么 + 可执行检查。
> 本文件由 `e2e init` 生成骨架，请按项目实际增删（建议 ≤15 条）。

- **C1 未过门禁不进下一段**。为什么：门禁是人介入边界。检查：skill 第 0 步探针 `--gate-only`，退出 64 即拒绝。
- **C2 能用可执行验证的绝不用"我觉得对了"**。为什么：只有可执行验证真正约束 agent。检查：每阶段制品有 check-*.sh 且交付前强制跑。
- **C3 安全边界只认服务端强制**。hooks/CLAUDE.md 是本地快反馈与建议；硬策略=permission system + 受保护分支 + CI required checks。
- **C4 产物是真相，工具是适配**。`specs/` `docs/` 放仓库根；`.claude/` 不放业务真相。
- **C5 一事一 ADR，决策必含 ≥2 真实备选，不可变只追加**。
EOF
}

tpl_glossary() { cat <<'EOF'
# 名词表（Glossary）

> 全项目唯一名词权威。各阶段词条汇总于此，冲突以本文件为准。

## 全局

| 名词 | 定义 |
|---|---|
| 六门禁 | ⓪立项 ①需求 ②架构 ③合并 ④发布 ⑤退役——人审介入点，证据触发而非日期 |
| 产物状态机 | prfaq→prd→spec/plan→tasks→code→PR→release→退役 的制品流转链 |
| 探针 | 可执行验证脚本，替代"我觉得对了" |

## 阶段 0

（随 e2e-discovery 使用补充）

## 阶段 1

（随 e2e-requirements 使用补充）

## 阶段 2

（随 e2e-design 使用补充）

## 阶段 3

（随 e2e-implement 使用补充）
EOF
}

tpl_settings() { cat <<'EOF'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(bash scripts/*)", "Bash(bash .claude/skills/*/scripts/*)"]
  }
}
EOF
}

# ---------- 分发 ----------
case "${1:-}" in
  doctor)  shift; cmd_doctor "$@" ;;
  init)    shift; cmd_init "$@" ;;
  version) echo "e2e ${E2E_VERSION}" ;;
  ""|-h|--help|help) usage ;;
  *) echo "未知子命令: $1"; echo; usage; exit 64 ;;
esac
