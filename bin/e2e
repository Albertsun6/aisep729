#!/usr/bin/env bash
# e2e — E2E 研发平台 CLI（SPEC-26 / ADR-010）
#
# 子命令：
#   doctor   分层前置检查（基础层/远程层/目标栈层），缺项给安装指引
#   init     绿地脚手架：在当前目录生成平台目录树（幂等，不覆盖）
#   version  版本与实测基线
#
# 设计原则（ADR-010）：bash 只做薄编排；"零依赖"精确表述为"基础层零额外安装"。
set -u
E2E_VERSION="0.1.0-M1"
E2E_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<EOF
e2e ${E2E_VERSION} — 企业级端到端研发平台 CLI

用法: e2e <子命令>

  doctor              检查前置工具（分层：基础/远程/目标栈）
  init [目录]         在目标目录生成平台骨架（绿地，幂等不覆盖）
  assess <仓> [-o 出]  存量项目只读体检（产物出仓外，不动目标仓一个字节）
  adopt <仓>          存量项目非破坏接入（既有文件一律保留，冲突列清单）
  version             显示版本

文档: docs/process/stages/ · 宪法: docs/constitution.md
EOF
}

# ---------- doctor（SPEC-26）----------
cmd_doctor() {
  local miss=0 warn=0
  echo "== e2e doctor（前置分层检查，ADR-010）=="

  echo
  echo "【基础层】本地全流程必需"
  chk_req git      "brew install git（或 xcode-select --install）"      || miss=$((miss+1))
  chk_req bash     "macOS 自带；如缺请检查 PATH"                          || miss=$((miss+1))
  # Claude Code 用于跑 skill；探针本身不依赖它
  chk_opt claude   "npm install -g @anthropic-ai/claude-code" "跑 e2e-* skill 需要" || warn=$((warn+1))

  echo
  echo "【远程层】门禁③服务端校验与 CI 需要"
  chk_opt gh       "brew install gh && gh auth login" "门禁③（PR/checks）与 CI 操作需要" || warn=$((warn+1))

  echo
  echo "【目标栈层】按项目技术栈，缺失时相应能力降级"
  chk_opt jq       "brew install jq"          "结构化输出解析（AI 评审 workflow）" || warn=$((warn+1))
  chk_opt shellcheck "brew install shellcheck" "bash 项目的 ratchet linter 适配器" || warn=$((warn+1))
  # 评审 reviewer #4 指出：check-demo-video.sh 引入了这两个外部依赖却从未在此声明（违反 C15）
  chk_opt ffprobe  "brew install ffmpeg"     "演示视频交付判据探针（SPEC-25）" || warn=$((warn+1))
  chk_opt gitleaks "brew install gitleaks"   "全历史 secret 扫描（门禁④ PRR）"   || warn=$((warn+1))

  echo
  if [ "$miss" -gt 0 ]; then
    echo "FAIL: 基础层缺 ${miss} 项——按上方指引安装后重试"
    return 1
  fi
  if [ "$warn" -gt 0 ]; then
    echo "PASS（有 ${warn} 项可选缺失）: 基础层齐备，相关能力将按 ADR-010 降级——不是错误"
    return 0
  fi
  echo "PASS: 全部前置齐备"
  return 0
}

chk_req() {  # chk_req <cmd> <安装指引>
  if command -v "$1" >/dev/null 2>&1; then
    printf '  ✅ %-12s %s\n' "$1" "$(command -v "$1")"; return 0
  fi
  printf '  ❌ %-12s 缺失 → %s\n' "$1" "$2"; return 1
}

chk_opt() {  # chk_opt <cmd> <安装指引> <用途>
  if command -v "$1" >/dev/null 2>&1; then
    printf '  ✅ %-12s %s\n' "$1" "$(command -v "$1")"; return 0
  fi
  printf '  ⚠️  %-12s 缺失（%s）→ %s\n' "$1" "$3" "$2"; return 1
}

# ---------- init（SPEC-9/10/11，M1 砍线：只出目录树）----------
cmd_init() {
  local target="${1:-.}"
  target="$(cd "$target" 2>/dev/null && pwd)" || { echo "FAIL(65): 目标目录不存在: ${1:-.}"; return 65; }
  [ "$target" = "$E2E_HOME" ] && { echo "FAIL(64): 不能在平台仓自身跑 init"; return 64; }

  echo "== e2e init → ${target} =="
  local conflicts=0 created=0

  # 目录树
  for d in .claude/skills .claude/agents .claude/hooks .claude/rules \
           docs/architecture/adr docs/process/stages docs/runbooks \
           specs scripts/lib tests/probe-negative .github/workflows; do
    mkdir -p "$target/$d"
  done

  # 平台能力层 + 共用生成物：与 adopt **同一份清单**（见 CAP_TREES / CAP_FILES）
  install_capability_layer
  install_generated_common
  gen_file "docs/architecture/spine.md" "$(tpl_spine)"

  warn_hooks_unregistered
  echo
  if [ "$conflicts" -gt 0 ]; then
    echo "完成（${created} 个新建，${conflicts} 个已存在未覆盖）"
    echo "⚠️  冲突项已保留原文件（SPEC-10 幂等安全）"
    return 2
  fi
  echo "PASS: ${created} 个文件已生成"
  echo "下一步: cd ${target} && e2e doctor，然后用 e2e-discovery skill 立项"
  return 0

}

# copy_tree —— **逐文件**判存在，与 copy_one 同一套语义。
#
# 冷启动验收抓到的 blocker：旧实现是 `cp -R "$src/." "$dst/"`，**整目录无条件覆盖**。
# 于是 `e2e init` 第二次跑会静默清除用户对 .claude/skills/、.claude/agents/、
# .claude/hooks/、scripts/lib/、docs/process/stages/ 下**所有文件**的修改 ——
# 而工具此时还打印「⚠️ 冲突项已保留原文件（SPEC-10 幂等安全）」，**给出的是相反的保证**。
# 「改了 skill → 想升级平台 → 再跑一次 init」是完全自然的路径，代价是丢工作。
# 实测复现：改 SKILL.md 与 stop-verify.sh 后重跑 init，两处修改都没了。
copy_tree() {
  [ -d "$E2E_HOME/$1" ] || return 1
  local n_new=0 n_skip=0 rel dst
  while IFS= read -r src; do
    [ -n "$src" ] || continue
    rel="${src#$E2E_HOME/}"
    dst="$target/$rel"
    if [ -e "$dst" ]; then
      n_skip=$((n_skip + 1)); conflicts=$((conflicts + 1))
      conflict_list="${conflict_list:-}\n- \`${rel}\`（平台版未覆盖，如需采用请手工比对）"
    else
      mkdir -p "$(dirname "$dst")"; cp "$src" "$dst"
      n_new=$((n_new + 1)); created=$((created + 1))
    fi
  done <<INNER
$(find "$E2E_HOME/$1" -type f 2>/dev/null | sort)
INNER
  if [ "$n_skip" -gt 0 ]; then
    printf '  %s %s/（新增 %s，已存在未覆盖 %s）\n' \
      "$([ "$n_new" -gt 0 ] && echo '+' || echo '=')" "$1" "$n_new" "$n_skip"
  else
    printf '  + %s/（%s 个文件）\n' "$1" "$n_new"
  fi
}
copy_one()  { [ -f "$E2E_HOME/$1" ] || return 1
  if [ -f "$target/$1" ]; then printf '  = %s（已存在，跳过）\n' "$1"; conflicts=$((conflicts+1))
    conflict_list="${conflict_list:-}\n- \`${1}\`（平台版未覆盖，如需采用请手工比对）"; return 0; fi
  mkdir -p "$(dirname "$target/$1")"; cp "$E2E_HOME/$1" "$target/$1"; created=$((created+1)); printf '  + %s\n' "$1"; }
gen_file()  {
  if [ -f "$target/$1" ]; then printf '  = %s（已存在，跳过）\n' "$1"; conflicts=$((conflicts+1))
    conflict_list="${conflict_list:-}\n- \`${1}\`（平台版未覆盖；建议把平台约定手工并入你的版本）"; return 0; fi
  # 空内容必须响亮失败（实测教训）：tpl_ci / tpl_spine 曾**从未定义**，
  # `$(tpl_ci)` 只在 stderr 留一行 command not found，然后静静写出 1 字节空文件——
  # 业务仓一键接入后拿到的是空 workflow（GitHub 视为无效 = 根本没有 CI）。
  # 脚手架产出空文件比不产出更危险：目录看起来齐全，门禁其实不存在。
  if [ -z "${2:-}" ] || [ -z "$(printf '%s' "${2:-}" | tr -d '[:space:]')" ]; then
    echo "FAIL(66): 模板 $1 渲染为空——拒绝写出空脚手架文件（模板函数缺失或渲染失败）" >&2
    return 66
  fi
  mkdir -p "$(dirname "$target/$1")"; printf '%s\n' "$2" > "$target/$1"; created=$((created+1)); printf '  + %s\n' "$1"; }

# ---------- 能力层清单：init 与 adopt **共用同一份** ----------
#
# 冷启动验收 blocker：adopt 曾自己维护一份**平行**清单。平台后来陆续加了
# hook、CI 模板、负样本套件、5 个探针，只加进 init 的清单 —— adopt 的没人记得同步。
# 实测差距：init 发 60 个文件，adopt 只发 49，缺的正好是
# **0 个 hook / 0 个 CI / 0 条负样本 / 无 settings.json**。
# 后果不是"少点东西"，是**存量仓拿到一个残废安装还以为装好了**：
# README 教的三条验收命令，第一条 FAIL、第三条文件根本不存在。
#
# 修法是结构性的：共用一份清单 → 漂移**不可能**再发生。
# 由 scripts/check-adopt-parity.sh 钉住（会失败的断言，不是靠记性）。
CAP_TREES=".claude/skills .claude/agents .claude/hooks scripts/lib docs/process/stages"
CAP_FILES="bin/e2e
scripts/check-shell-traps.sh
scripts/check-structure.sh
scripts/check-skill-deps.sh
scripts/check-clause-refs.sh
scripts/check-action-pins.sh
scripts/check-ai-review-contract.sh
scripts/check-readme.sh
scripts/check-marketplace-sha.sh
scripts/check-selfcontained.sh
scripts/check-adopt-parity.sh
scripts/ratchet.sh
ops/check-branch-protection.sh
tests/probe-negative/run.sh
tests/probe-negative/ratchet-negative.sh
docs/process/skills-manifest.md
docs/process/risk-tiers.md"

# install_capability_layer —— 平台能力（可执行部分）。init/adopt 一字不差地共用。
# 依赖调用方 local 的 target/conflicts/created（bash 动态作用域）。
install_capability_layer() {
  local d f
  for d in $CAP_TREES; do copy_tree "$d" || true; done
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    copy_one "$f" || true
  done <<CAPEOF
$CAP_FILES
CAPEOF
  # 宪法必须发完整版：skill / agent 大量引用 C6-C15，只发残桩会让 agent
  # "读 C14"时读到一个没有 C14 的文件，然后静默按无约束继续（评审实证）。
  copy_one "docs/constitution.md" || gen_file "docs/constitution.md" "$(tpl_constitution)"
}

# install_generated_common —— 两条路都要的生成物（模板渲染，既有文件一律不覆盖）。
# 不含 spine.md：init 用模板、adopt 用扫描基线，是**真正的差异**，各自处理。
install_generated_common() {
  gen_file "AGENTS.md"        "$(tpl_agents)"
  gen_file "CLAUDE.md"        "$(tpl_claude_md)"
  gen_file "docs/glossary.md" "$(tpl_glossary)"
  gen_file ".github/workflows/quality-gates.yml" "$(tpl_ci)"
  # settings.json 是**两个 hook 的唯一注册处**。目标仓已有同名文件时不能覆盖，
  # 但也**不能静静跳过** —— 那样 hook 一个都不生效，而用户以为装好了（fail-open）。
  if [ -f "$target/.claude/settings.json" ]; then
    hooks_unregistered=1
  else
    gen_file ".claude/settings.json" "$(tpl_settings)"
  fi
}

# 已有 settings.json 时必须**响亮**地说清后果与做法，不能只在冲突清单里列一行路径。
warn_hooks_unregistered() {
  [ "${hooks_unregistered:-0}" = "1" ] || return 0
  cat <<'WARN'

⚠️  你的仓已有 .claude/settings.json —— 未覆盖，于是**两个 hook 一个都没注册**。
    后果：改完文件不会即时 lint、收工不会强制验证。**门禁看着装好了，其实没生效。**
    做法：把下面这段合进你现有的 settings.json（已有 hooks 字段就并进去）：

      "hooks": {
        "PostToolUse": [{ "matcher": "Edit|Write",
          "hooks": [{ "type": "command", "command": "bash .claude/hooks/post-edit-lint.sh" }] }],
        "Stop": [{ "hooks": [{ "type": "command", "command": "bash .claude/hooks/stop-verify.sh" }] }]
      }
WARN
}

# ---------- assess（SPEC-12：只读体检，产物出仓外）----------
# 只读证明：本命令**不写目标仓任何路径**，三产物一律落 <repo>/../e2e-assess-<name>-<ts>/
# 探针验证方式：assess 前后 `git status --porcelain=v1 -uall` 完整快照零差异
cmd_assess() {
  local repo="${1:-.}" out=""
  [ "$repo" = "-o" ] && { echo "FAIL(64): 用法 e2e assess <repo> [-o 输出目录]"; return 64; }
  shift 2>/dev/null || true
  [ "${1:-}" = "-o" ] && { out="${2:-}"; }

  repo="$(cd "$repo" 2>/dev/null && pwd)" || { echo "FAIL(65): 目标仓不存在"; return 65; }
  local name ts
  name="$(basename "$repo")"; ts="$(date +%Y%m%d-%H%M%S)"
  out="${out:-$(dirname "$repo")/e2e-assess-${name}-${ts}}"
  case "$out" in "$repo"|"$repo"/*) echo "FAIL(64): 输出目录不得在目标仓内（只读体检，SPEC-12）"; return 64 ;; esac
  mkdir -p "$out" || { echo "FAIL(65): 无法创建输出目录 ${out}"; return 65; }

  echo "== e2e assess: ${repo} =="
  echo "   输出 → ${out}（仓外，只读体检）"

  # --- 历史深度（S4：浅历史降级）---
  local commits shallow="" hist_ok=1
  if git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    commits=$(git -C "$repo" rev-list --count HEAD 2>/dev/null || echo 0)
    [ -f "$(git -C "$repo" rev-parse --git-dir)/shallow" ] && shallow="（shallow clone）"
    # 判据要数**churn 窗口内**的 commit，不是全部历史：
    # 一个 500 commits 但近一年没动过的老仓，按全量算 hist_ok=1，
    # 而 `--since="1 year ago"` 的 churn 表是**空的** → 热点档位建立在零数据上。
    win=$(git -C "$repo" rev-list --count --since="1 year ago" HEAD 2>/dev/null || echo 0)
    : "${win:=0}"
    [ "$commits" -lt 20 ] && hist_ok=0
    [ "$win" -lt 20 ] && hist_ok=0
  else
    commits=0; hist_ok=0
  fi

  # --- 1. 热点：churn × complexity（S4 降级：历史不足则跳过 churn 只报规模）---
  {
    echo "# 热点清单：${name}"
    echo
    echo "> 生成于 ${ts}｜历史深度：${commits} commits ${shallow}"
    echo
    if [ "$hist_ok" -eq 1 ]; then
      echo "口径：churn（近一年改动次数）× complexity（非空行数），取乘积 Top 20。"
      echo
      printf '| 文件 | churn | 行数 | 热度 |\n|---|---|---|---|\n'
      git -C "$repo" log --since="1 year ago" --name-only --format= 2>/dev/null \
        | grep -v '^$' | sort | uniq -c | sort -rn | head -60 \
        | while read -r c f; do
            [ -f "$repo/$f" ] || continue
            local_lines=$(grep -vc '^[[:space:]]*$' "$repo/$f" 2>/dev/null); : "${local_lines:=0}"
            printf '| %s | %s | %s | %s |\n' "$f" "$c" "$local_lines" "$((c * local_lines))"
          done | sort -t'|' -k5 -rn | head -20
    else
      echo "⚠️ **历史不足，热点分析跳过**（S4 降级）：全量 ${commits} commits、**近一年 ${win} commits**${shallow}——churn 数据不可信。"
      echo
      echo "> 判据看的是**近一年**的 commit 数：老仓即使历史很长，近期不活跃时 churn 也没有意义。"
      echo
      echo "改用**规模清单**（非空行数 Top 20）作为替代信号——注意：大文件 ≠ 高风险，仅供人工判断起点。"
      echo
      printf '| 文件 | 行数 |\n|---|---|\n'
      find "$repo" -type f \( -name '*.sh' -o -name '*.py' -o -name '*.js' -o -name '*.ts' -o -name '*.go' -o -name '*.java' -o -name '*.rb' \) \
        -not -path '*/.git/*' -not -path '*/node_modules/*' 2>/dev/null \
        | while read -r f; do n=$(grep -vc '^[[:space:]]*$' "$f" 2>/dev/null); printf '%s %s\n' "${n:-0}" "${f#$repo/}"; done \
        | sort -rn | head -20 | while read -r n f; do printf '| %s | %s |\n' "$f" "$n"; done
    fi
  } > "$out/hotspots.md"

  # --- 2. 健康度报告 ---
  {
    echo "# 健康度基线：${name}"
    echo
    echo "> ${ts}｜**只读体检，未改动目标仓任何文件**"
    echo
    echo "## 概览"
    printf '| 项 | 值 |\n|---|---|\n'
    printf '| git 历史 | %s commits %s |\n' "$commits" "$shallow"
    printf '| 跟踪文件数 | %s |\n' "$(git -C "$repo" ls-files 2>/dev/null | wc -l | tr -d ' ')"
    printf '| 热点分析 | %s |\n' "$([ "$hist_ok" -eq 1 ] && echo '可用' || echo '⚠️ 降级（历史不足，见 hotspots.md）')"
    echo
    echo "## 文档缺口"
    for f in README.md AGENTS.md CLAUDE.md docs/constitution.md docs/architecture/spine.md; do
      printf '| %s | %s |\n' "$f" "$([ -e "$repo/$f" ] && echo '✅ 有' || echo '❌ 缺')"
    done | sed '1i\
| 文件 | 状态 |\
|---|---|'
    echo
    echo "## 测试覆盖缺口（启发式）"
    local srcn testn
    srcn=$(find "$repo" -type f \( -name '*.sh' -o -name '*.py' -o -name '*.js' -o -name '*.ts' \) -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*test*' 2>/dev/null | wc -l | tr -d ' ')
    testn=$(find "$repo" -type f \( -path '*test*' -o -path '*spec*' \) -not -path '*/.git/*' -not -path '*/node_modules/*' 2>/dev/null | wc -l | tr -d ' ')
    printf -- '- 源文件（估）：%s｜测试相关文件：%s\n' "$srcn" "$testn"
    [ "$testn" -eq 0 ] && echo "- ⚠️ **未发现任何测试文件**——这是接入平台后的首要补齐项（宪法 C2）"
    echo
    echo "## 死代码线索（启发式，需人工确认）"
    echo "> 方法：文件名在仓内其余文件中零引用。**误报率高**（动态加载/入口文件/配置驱动都会误报），仅作排查起点。"
    echo
    git -C "$repo" ls-files 2>/dev/null | grep -E '\.(sh|py|js|ts)$' | head -100 | while read -r f; do
      b=$(basename "$f"); b_noext="${b%.*}"
      cnt=$(git -C "$repo" grep -l -- "$b_noext" 2>/dev/null | grep -vc "^${f}$"); : "${cnt:=0}"
      [ "$cnt" -eq 0 ] 2>/dev/null && printf -- '- %s\n' "$f"
    done | head -15
    echo
    echo "## 下一步"
    echo "1. 人工核对 risk-tiers 初稿（本次生成于同目录），按业务实际调整高风险路径"
    echo "2. \`e2e adopt <repo>\` 非破坏接入（不覆盖任何既有文件）"
    echo "3. 先只挂门禁③（PR 评审+CI ratchet），跑顺一个月再向两端扩"
  } > "$out/health-baseline.md"

  # --- 3. risk-tiers 初稿 ---
  {
    echo "# 风险分级路由表（初稿，由 e2e assess 生成于 ${ts}）"
    echo
    echo "> ⚠️ **这是机器生成的起点，不是结论**。必须人工核对后才可作为门禁依据。"
    echo "> 本文件自身应列为高风险路径（改门禁规则须人审）。"
    echo
    printf '| 档 | 匹配路径（glob） | 依据 | 人审 |\n|---|---|---|---|\n'
    printf '| **高** | `docs/constitution.md` `docs/process/risk-tiers.md` `.github/workflows/**` `**/*secret*` `**/*credential*` `**/auth/**` `**/*migration*` | 规则本身/CI/凭据/认证/数据迁移 | 强制 |\n'
    # 热点行**按模式抽**，不按固定行号：
    # 旧写法 `head -8 | tail -3` 取到的是空行+表头+分隔行，于是 glob 恒为字面量 `---`
    # ——一条永远匹配不到任何文件的"高风险"规则，看着有、实际没有（冷启动实测）。
    # 而且正常/降级两个分支的表格起始行号还不一样，固定偏移在哪个分支上都不对。
    if [ "$hist_ok" -eq 1 ]; then
      hot=$(awk -F'|' 'NF>2 {
               v=$2; gsub(/^[ \t]+|[ \t]+$/,"",v);
               if (v!="" && v!="文件" && v !~ /^-+$/) { printf "`%s` ", v; n++ }
               if (n>=3) exit
             }' "$out/hotspots.md")
      if [ -n "$(printf '%s' "$hot" | tr -d '[:space:]')" ]; then
        printf '| **高（热点）** | %s| churn×complexity Top 3（assess 实测） | 强制 |\n' "$hot"
      else
        # 抽不出来就**说出来**，不要写一行匹配不到东西的假规则
        printf '| **高（热点）** | （未能从 hotspots.md 抽出文件名——请人工填）| assess 抽取失败，勿当作"无热点" | 强制 |\n'
      fi
    fi
    printf '| **中** | `src/**` `lib/**` `app/**` `scripts/**` `bin/**` | 可执行代码 | 建议 |\n'
    printf '| **低** | `docs/**` `*.md` `.gitignore` | 文字与配置 | 否 |\n'
    # 兜底档必须有：否则新目录、新语言、新产物**不匹配任何 glob** = 没有档
    # = 事实上按最低档处理，而没有任何人做过这个决定（fail-open）。
    printf '| **中（兜底）** | 以上都不匹配的任何路径 | 未分类不得默认为低风险——先按中档人工判 | 建议 |\n'
    echo
    echo "## 升档触发（默认启发值，非实证安全线）"
    echo "- 净改动 >400 行 或 文件数 >15 → 升档；>1000 行 → 默认要求拆分"
    echo "- 删除测试 / 新增外部依赖 / 门禁打回 ≥2 次"
  } > "$out/risk-tiers-draft.md"

  echo "  + hotspots.md         （热点清单$([ "$hist_ok" -eq 1 ] || echo '，⚠️ 已降级')）"
  echo "  + health-baseline.md  （健康度基线）"
  echo "  + risk-tiers-draft.md （风险分级初稿，需人工核对）"
  echo
  echo "PASS: 体检完成，目标仓未被改动（SPEC-12 只读契约）"
  echo "下一步: e2e adopt ${repo}"
  return 0
}

# ---------- adopt（SPEC-13：非破坏叠加）----------
cmd_adopt() {
  local target="${1:-.}"
  target="$(cd "$target" 2>/dev/null && pwd)" || { echo "FAIL(65): 目标仓不存在"; return 65; }
  [ "$target" = "$E2E_HOME" ] && { echo "FAIL(64): 不能在平台仓自身跑 adopt"; return 64; }
  git -C "$target" rev-parse --git-dir >/dev/null 2>&1 || { echo "FAIL(64): 目标不是 git 仓库（adopt 需要历史来做基线与追认 ADR）"; return 64; }

  echo "== e2e adopt: ${target}（非破坏叠加，既有文件一律不覆盖）=="
  local conflicts=0 created=0 conflict_list=""

  for d in .claude/skills .claude/agents .claude/hooks .claude/rules \
           docs/architecture/adr docs/process/stages docs/runbooks \
           specs scripts/lib tests/probe-negative .github/workflows; do
    mkdir -p "$target/$d"
  done

  # 能力层：与 init **同一份清单**（CAP_TREES / CAP_FILES）。
  # 这里曾是一份手抄的平行清单，漂移到比 init 少 12 个文件 —— 见 CAP_FILES 处的说明。
  install_capability_layer

  # 架构基线（as-is，不写理想架构）
  if [ ! -f "$target/docs/architecture/spine.md" ]; then
    {
      echo "# Architecture Spine（as-is 基线，由 e2e adopt 扫描生成 $(date +%Y-%m-%d)）"
      echo
      echo "> ⚠️ 机器扫描的**现状**快照，不是理想架构。理想态写进 ADR 的 proposed 决策。"
      echo "> ≤300 行纪律：随架构变更 PR 同步更新。"
      echo
      echo "## 顶层结构"
      echo '```text'
      (cd "$target" && git ls-files 2>/dev/null | awk -F/ 'NF>1{print $1"/"}NF==1{print $1}' | sort -u | head -25)
      echo '```'
      echo
      echo "## 规模"
      printf -- '- 跟踪文件：%s\n' "$(git -C "$target" ls-files 2>/dev/null | wc -l | tr -d ' ')"
      printf -- '- 历史：%s commits\n' "$(git -C "$target" rev-list --count HEAD 2>/dev/null || echo 0)"
      echo
      echo "## 已知债务（如实记录，不粉饰）"
      echo "- <接入时人工补充：已知的技术债、绕不开的历史包袱>"
    } > "$target/docs/architecture/spine.md"
    created=$((created+1)); printf '  + docs/architecture/spine.md（as-is 扫描基线）\n'
  else
    printf '  = docs/architecture/spine.md（已存在，保留）\n'; conflicts=$((conflicts+1))
  fi

  # 追认 ADR 框架（git 考古起点）
  if [ ! -e "$target/docs/architecture/adr/ADR-001-retroactive-baseline.md" ]; then
    {
      echo "# ADR-001：接入 E2E 平台时的现状基线（retroactive）"
      echo
      echo "- 状态：accepted（**retroactive-baseline**：追认既有事实，非新决策）"
      echo "- 日期：$(date +%Y-%m-%d)"
      echo
      echo "## 背景与驱动力"
      echo "本仓库在接入 E2E 平台前已有 $(git -C "$target" rev-list --count HEAD 2>/dev/null || echo 0) 次提交的历史。"
      echo "既有技术选型未经 ADR 记录，本文追认现状以建立可追溯起点。"
      echo
      echo "## 备选方案"
      echo
      echo "### 选项 A：补写全部历史 ADR"
      echo "- 优点：历史完整"
      echo "- 代价：考古成本极高，且多数决策的当事人与语境已不可考——大概率写成事后合理化"
      echo
      echo "### 选项 B：只追认基线，从今天起新决策才写 ADR"
      echo "- 优点：成本可控；ADR 从此有真实决策语境"
      echo "- 代价：历史决策仍无据可查（接受）"
      echo
      echo "## 决定"
      echo "选 B。**不补写历史，只锁定基线**：本 ADR 之后的架构决策一律走 ADR。"
      echo
      echo "## 后果"
      echo "- ✅ 追溯起点明确，成本可控"
      echo "- ⚠️ 历史决策仍是黑盒——遇到时按需补 retroactive ADR（标注 retroactive）"
      echo
      echo "## 待人工补充"
      echo "<接入者：请在此列出 3-5 条最值得追认的既有决策，如技术栈选型/分层约定/部署形态>"
    } > "$target/docs/architecture/adr/ADR-001-retroactive-baseline.md"
    created=$((created+1)); printf '  + docs/architecture/adr/ADR-001-retroactive-baseline.md（追认基线）\n'
  fi

  # 共用生成物（AGENTS/CLAUDE/glossary/CI/settings）：与 init 同一套，既有文件一律不覆盖
  install_generated_common

  # 冲突清单（SPEC-13：该文件已存在时写仓外时间戳文件并退出 2）
  if [ "$conflicts" -gt 0 ]; then
    local cfile="$target/docs/adopt-conflicts.md"
    if [ -e "$cfile" ]; then
      cfile="$(dirname "$target")/e2e-adopt-conflicts-$(basename "$target")-$(date +%Y%m%d-%H%M%S).md"
      printf '  ! docs/adopt-conflicts.md 已存在 → 冲突清单改写到仓外：%s\n' "$cfile"
    fi
    {
      echo "# adopt 冲突清单（$(date +%Y-%m-%d)）"
      echo
      echo "以下路径**已存在于本仓**，adopt 未覆盖（非破坏原则，SPEC-13）："
      printf '%b\n' "$conflict_list"
      echo
      echo "处理建议：逐项比对平台版与现有版，需要采用平台版时手工合入。"
    } > "$cfile"
  fi

  warn_hooks_unregistered
  echo
  echo "完成：${created} 个新建，${conflicts} 个已存在未覆盖"
  echo "下一步: cd ${target} && e2e doctor；然后用 e2e-discovery 立项第一个 delta 变更（specs/<change>/）"
  [ "$conflicts" -gt 0 ] && return 2
  return 0
}

# ---------- 模板 ----------
tpl_claude_md() { cat <<'EOF'
# 项目上下文（Claude Code 常驻规则）

> 本文件 ≤200 行（SPEC-11）。深知识放 skills 按需加载，工程原则见宪法。

@docs/constitution.md

## 本项目

- 生命周期：六段治理底图 × 产物状态机（见 docs/process/stages/）
- 制品位置：`specs/<feature>/`（prfaq→prd→spec/plan→tasks）
- 门禁：⓪立项 ①需求 ②架构 ③合并 ④发布 ⑤退役
- 能力：`.claude/skills/e2e-*`（拓扑见 docs/process/skills-manifest.md）

## 纪律

- 未过门禁不进下一段（skill 第 0 步自校验）
- 每条任务带可执行验证方式；能验证的绝不用"我觉得对了"
- 探针在 `scripts/` 与各 skill 的 `scripts/`，交付前必须跑
EOF
}

tpl_agents() { cat <<'EOF'
# AGENTS.md — 工具无关的 agent 入口

本仓库采用六段端到端生命周期 + 产物状态机，制品在 `specs/<feature>/`。

## 快速上手
- 前置检查：`e2e doctor`
- 结构自审：`bash scripts/check-structure.sh`（若存在）
- 阶段定义：`docs/process/stages/`
- 工程宪法：`docs/constitution.md`（不可妥协原则）

## 约定
- 产物是真相（`docs/` `specs/`），`.claude/` 只是 Claude 适配层
- 门禁记录在各制品尾部；试点模式下为流程留痕，非防伪审批证据
EOF
}

tpl_constitution() { cat <<'EOF'
# 工程宪法（Constitution）

> 项目级不可妥协原则。修宪 = 独立 ADR。每条：原则 + 为什么 + 可执行检查。
> 本文件由 `e2e init` 生成骨架，请按项目实际增删（建议 ≤15 条）。

- **C1 未过门禁不进下一段**。为什么：门禁是人介入边界。检查：skill 第 0 步探针 `--gate-only`，退出 64 即拒绝。
- **C2 能用可执行验证的绝不用"我觉得对了"**。为什么：只有可执行验证真正约束 agent。检查：每阶段制品有 check-*.sh 且交付前强制跑。
- **C3 安全边界只认服务端强制**。hooks/CLAUDE.md 是本地快反馈与建议；硬策略=permission system + 受保护分支 + CI required checks。
- **C4 产物是真相，工具是适配**。`specs/` `docs/` 放仓库根；`.claude/` 不放业务真相。
- **C5 一事一 ADR，决策必含 ≥2 真实备选，不可变只追加**。
EOF
}

tpl_glossary() { cat <<'EOF'
# 名词表（Glossary）

> 全项目唯一名词权威。各阶段词条汇总于此，冲突以本文件为准。

## 全局

| 名词 | 定义 |
|---|---|
| 六门禁 | ⓪立项 ①需求 ②架构 ③合并 ④发布 ⑤退役——人审介入点，证据触发而非日期 |
| 产物状态机 | prfaq→prd→spec/plan→tasks→code→PR→release→退役 的制品流转链 |
| 探针 | 可执行验证脚本，替代"我觉得对了" |

## 阶段 0

（随 e2e-discovery 使用补充）

## 阶段 1

（随 e2e-requirements 使用补充）

## 阶段 2

（随 e2e-design 使用补充）

## 阶段 3

（随 e2e-implement 使用补充）

## 阶段 4

（随 e2e-review 使用补充）

## 阶段 5

（随 e2e-release 使用补充）

## 阶段 6

（随 e2e-retire 使用补充）
EOF
}

tpl_spine() { cat <<'EOF'
# Architecture Spine（骨架基线）

> ≤300 行纪律：随架构变更 PR 同步更新。这里写**现状**，理想态写进 ADR 的 proposed 决策。
> 由 `e2e init` 生成初稿，首次架构决策（门禁②）前必须由人补齐。

## 顶层结构

<待填：目录树与各目录职责，一行一项>

## 分层与依赖方向

<待填：允许的依赖方向；被禁止的反向依赖>

## 关键不变量

<待填：不能被违反的约束，每条须可被探针或测试证伪>

## 外部依赖与信任边界

<待填：第三方依赖清单、进出数据的边界、凭据存放位置>

## 已知债务

<待填：明知不合理但本轮不动的地方 + 复议条件>
EOF
}

tpl_ci() { cat <<'EOF'
name: quality-gates

# ⚠️ required status check 对应 **job**（check-run）而非 step。
# 若把所有检查塞进一个 job 的多个 step，分支保护里只能勾到一个名字，
# 单个 step 失败的可见性也会丢失。故按关注点拆成独立 job。
on:
  pull_request:
  push:
    branches: [main]

env:
  # 改成你的 feature 目录名（specs/<FEATURE>/）
  FEATURE: <feature>

jobs:
  process-gates:
    runs-on: macos-latest   # ADR-007：仅 macOS 实测，CI 显式钉住避免 BSD/GNU 差异
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5（C15：SHA-pin，tag 可被移动）
      - name: 阶段0 探针（prfaq 结构）
        run: bash .claude/skills/e2e-discovery/scripts/check-prfaq.sh "specs/$FEATURE/prfaq.md"
      - name: 阶段1 探针（PRD 结构 + 门禁⓪串锁）
        run: bash .claude/skills/e2e-requirements/scripts/check-prd.sh "specs/$FEATURE/"
      - name: 阶段2 探针（设计制品 + 宪法/ADR 规则）
        run: bash .claude/skills/e2e-design/scripts/check-design.sh "specs/$FEATURE/"
      - name: 阶段3 探针（tasks 逐条验证行）
        run: bash .claude/skills/e2e-implement/scripts/check-tasks.sh "specs/$FEATURE/"

  structure-gates:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5（C15：SHA-pin，tag 可被移动）
      - name: 结构自审（六件套 / manifest 驱动 / 宪法 C4）
        run: bash scripts/check-structure.sh
      - name: bash 高危写法（macOS BSD 陷阱）
        run: bash scripts/check-shell-traps.sh
      - name: skill 依赖存在性（防脚手架缺口导致静默跳过检查）
        run: bash scripts/check-skill-deps.sh
      - name: 宪法条款引用（防条款层 fail-open）
        run: bash scripts/check-clause-refs.sh
      - name: 第三方 Action SHA-pin（C15）
        run: bash scripts/check-action-pins.sh
      - name: AI 评审三通道契约（LLM 不得有阻断权）
        run: bash scripts/check-ai-review-contract.sh

  probe-negatives:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5（C15：SHA-pin，tag 可被移动）
      - name: 探针负样本（宪法 C13：探针自身必须能证伪）
        run: bash tests/probe-negative/run.sh
EOF
}

tpl_settings() { cat <<'EOF'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(bash scripts/*)", "Bash(bash tests/*)", "Bash(bash .claude/skills/*/scripts/*)"]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lint.sh\"", "timeout": 20 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.sh\"", "timeout": 180 }] }
    ]
  }
}
EOF
}

# ---------- 分发 ----------
case "${1:-}" in
  doctor)  shift; cmd_doctor "$@" ;;
  init)    shift; cmd_init "$@" ;;
  assess)  shift; cmd_assess "$@" ;;
  adopt)   shift; cmd_adopt "$@" ;;
  version) echo "e2e ${E2E_VERSION}" ;;
  ""|-h|--help|help) usage ;;
  *) echo "未知子命令: $1"; echo; usage; exit 64 ;;
esac
